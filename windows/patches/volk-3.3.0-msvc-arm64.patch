# Provenance: MSVC-ARM64 / NEON enablement patch for GNU Radio VOLK v3.3.0.
#
# Derived from: JVital2013/volk commit 51c251846ba591453a92480a95a27a3ffe901d4b
#   "Windows: ARM64/NEON Support" (stock volk v3.1.2 + this feature).
# Ported by GobDump to the gnuradio/volk v3.3.0 tree (tag v3.3.0,
#   commit 511fff053e190316919733fb148b70946f139a9e).
#
# Purpose: enable native NEON / NEON-v8 kernels when building volk 3.3.0 with
#   the MSVC compiler toolchain targeting Windows ARM64. On MSVC the GNU-style
#   inline-asm feature checks fail (and MSVC-ARM64 has NEON always available),
#   and several NEON kernels use GNU/Clang-only vector brace-init / array-union
#   syntax that MSVC rejects. The fixes make these kernels compile under MSVC.
#
# This MSVC-ARM64 support is not yet upstreamed in gnuradio/volk; this patch
# re-applies the fork's conceptual changes on top of v3.3.0. It applies
# deterministically via:  git apply -p1 <this file>
#
# Hunk set (ported to 3.3.0; adapted where surrounding code changed upstream):
#   - gen/archs.xml                : add empty msvc flag to neon / neonv8 arch
#   - lib/CMakeLists.txt           : guard the neonv8 GNU-asm compile-check in
#                                    if(MSVC) so MSVC doesn't overrule neonv8
#   - volk_32fc_accumulator_s32fc.h: brace-init NEON vectors with { 0.f }
#   - volk_32fc_convert_16ic.h     : brace-init int32x4_t (neonv8) with { 0 }
#   - volk_32u_byteswap.h          : build idx vector via vld1q_u8()
#   - volk_32u_reverse_32u.h       : build idx via vld1q_u8() + MSVC DO_RBIT
#
# N.B. The fork's index_max / index_min union-array-access hunks are already
#   resolved upstream in v3.3.0 (those kernels now use separate *Buffer[]
#   arrays), so they are intentionally NOT carried into this patch.
diff --git a/gen/archs.xml b/gen/archs.xml
index a07485d..017147f 100644
--- a/gen/archs.xml
+++ b/gen/archs.xml
@@ -85,6 +85,7 @@ at the top, as a last resort.
 <arch name="neon">
   <flag compiler="gnu">-funsafe-math-optimizations</flag>
   <flag compiler="clang">-funsafe-math-optimizations</flag>
+  <flag compiler="msvc"> </flag>
   <alignment>16</alignment>
   <check name="neon"></check>
 </arch>
@@ -101,6 +102,7 @@ at the top, as a last resort.
 <arch name="neonv8">
   <flag compiler="gnu">-funsafe-math-optimizations</flag>
   <flag compiler="clang">-funsafe-math-optimizations</flag>
+  <flag compiler="msvc"> </flag>
   <alignment>16</alignment>
   <check name="neon"></check>
 </arch>
